---
import HeaderLink from './HeaderLink.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import { menuItems } from '../data';
---

<header class="flex flex-row justify-between items-center w-full mb-12 sm:mb-16">
  <nav class="flex flex-row gap-6 sm:gap-8 items-center">
    {menuItems.map((item) => (
      <HeaderLink href={item.url} external={item.external}>
        {item.label}
      </HeaderLink>
    ))}
  </nav>
  <ThemeSwitcher />
</header>
