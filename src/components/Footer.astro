---
import { socialLinks } from '../data';
import { withBase } from '../utils/site';
---

<footer class="w-full pt-16 pb-12 flex flex-row items-center gap-6 sm:gap-8 mt-24 text-sm sm:text-base text-[var(--color-text-secondary)]">
  {socialLinks.map((link) => {
    const isInternal = link.url.startsWith('/');
    return (
      <a
        href={isInternal ? withBase(link.url) : link.url}
        target={isInternal ? undefined : '_blank'}
        rel={isInternal ? undefined : 'noopener noreferrer'}
        class="hover:text-[var(--color-text)] transition-colors no-underline hover:underline underline-offset-4"
      >
        {link.label}
      </a>
    );
  })}
</footer>
